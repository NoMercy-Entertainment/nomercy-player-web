{
  "name": "@nomercy-entertainment/media-session",
  "type": "module",
  "version": "1.1.3",
  "description": "Media Session API for web browsers",
  "author": {
    "name": "NoMercy Entertainment",
    "email": "info@nomercy.tv",
    "url": "https://nomercy.tv"
  },
  "contributors": [
    "Stoney Eagle <stoney@nomercy.tv>"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/NoMercy-Entertainment/nomercy-media-session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoMercy-Entertainment/nomercy-player-web.git",
    "directory": "packages/media-session"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "run -T tsc",
    "typecheck": "run -T tsc --noEmit",
    "test": "run -T vitest run",
    "prepack": "node ../../scripts/pack-files.mjs copy",
    "postpack": "node ../../scripts/pack-files.mjs clean",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  }
}
