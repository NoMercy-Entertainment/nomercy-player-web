{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Self-imports must become relative paths in the published output (tsc-alias).
    "paths": {
      "@nomercy-entertainment/nomercy-video-player": ["./src/index.ts"]
    },
    "noPropertyAccessFromIndexSignature": true,
    // Video publishes no map files; enabling them changes the npm file list.
    "declarationMap": false,
    "sourceMap": false
  }
}
