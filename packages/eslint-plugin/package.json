{
  "name": "@nomercy-entertainment/eslint-plugin-player",
  "type": "module",
  "version": "0.3.0",
  "description": "ESLint rules that enforce the NoMercy player-trio v2 code standard.",
  "author": "NoMercy Entertainment",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NoMercy-Entertainment/eslint-plugin-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoMercy-Entertainment/nomercy-player-web.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/NoMercy-Entertainment/eslint-plugin-player/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "nomercy",
    "player"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "files": [
    "README.md",
    "index.js",
    "rules"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node ../../scripts/pack-files.mjs copy",
    "postpack": "node ../../scripts/pack-files.mjs clean",
    "check:duplicates": "node scripts/check-duplicate-symbols.mjs",
    "check:exports": "node scripts/check-package-exports.mjs"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript-eslint/typescript-estree": "^8.20.0",
    "ts-morph": "^24.0.0"
  }
}
