# Normalize every text file to LF
* text=auto eol=lf

# Windows batch files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Diffs
*.html diff=html
*.md diff=markdown
*.lock text -diff

# Binary
*.wasm binary
*.ttf binary
*.data binary
*.map binary
*.png binary

# Linguist
*.ts linguist-language=TypeScript
