{
  "name": "nomercy-player-web",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At --no-private run build",
    "build:core": "yarn workspace @nomercy-entertainment/nomercy-player-core run build",
    "build:iife": "yarn workspaces foreach -A --no-private run build:iife",
    "typecheck": "yarn build:core && yarn workspaces foreach -A --no-private run typecheck",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "test": "yarn workspaces foreach -A --no-private run test",
    "test:e2e": "yarn workspaces foreach -A --no-private run test:e2e"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nomercy-entertainment/eslint-plugin-player": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.60.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@istanbuljs/load-nyc-config/js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.12",
    "flatted": ">=3.4.2",
    "hls.js": "1.6.16",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.2",
    "minimatch": "10.2.4",
    "picomatch": ">=2.3.2",
    "tinypool@2.1.0": "2.1.2"
  }
}
